# Copy to .env in this folder.
# Only EMAIL notifications use these; CONSOLE notifications work without them.
# If they are wrong, sending fails with a logged error and nothing else breaks.

# Nodemailer well-known service name, e.g. gmail, hotmail, outlook365
EMAIL_PROVIDER=gmail
# Sender address
EMAIL=
# For Gmail, an app password (needs 2-step verification), not your account password
EMAIL_PASSWORD=
