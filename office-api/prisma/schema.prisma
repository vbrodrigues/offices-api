// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URI")
}

model Office {
  id                 String   @id @default(uuid())
  name               String
  owner_email        String
  owner_phone_number String?
  logo               String?  @db.VarChar(4096)
  created_at         DateTime @default(now())

  clients    Client[]
  employees  Employee[]
  roles      Role[]
  categories Category[]
  steps      Step[]
}

model Client {
  id           String    @id @default(uuid())
  office_id    String
  name         String
  email        String
  password     String
  phone_number String?
  logo         String?   @db.VarChar(4096)
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime?

  office   Office    @relation(fields: [office_id], references: [id])
  projects Project[]
}

// Job title of an office's employees ("Arquiteta", "Estagiário"). It only
// describes the person; what they can do comes from Employee.access_level.
model Role {
  id         String   @id @default(uuid())
  office_id  String
  label      String
  created_at DateTime @default(now())

  office    Office     @relation(fields: [office_id], references: [id])
  employees Employee[]

  @@unique([office_id, label])
}

// What an employee can do in the office; see auth/employee/permissions.ts.
// Each office has exactly one OWNER.
enum AccessLevel {
  OWNER
  PARTNER
  MEMBER
}

model Employee {
  id           String      @id @default(uuid())
  office_id    String
  // Job title; optional
  role_id      String?
  access_level AccessLevel @default(MEMBER)
  name         String
  email        String
  password     String
  phone_number String?
  avatar       String?     @db.VarChar(4096)
  is_active    Boolean     @default(true)
  created_at   DateTime    @default(now())
  updated_at   DateTime?

  office          Office          @relation(fields: [office_id], references: [id])
  role            Role?           @relation(fields: [role_id], references: [id], onDelete: SetNull)
  project_files   ProjectFile[]
  ProjectStep     ProjectStep[]
  project_folders ProjectFolder[]
}

model Category {
  id         String   @id @default(uuid())
  name       String
  office_id  String?
  created_at DateTime @default(now())

  office          Office?         @relation(fields: [office_id], references: [id])
  project_files   ProjectFile[]
  project_folders ProjectFolder[]
}

model Project {
  id         String    @id @default(uuid())
  client_id  String
  name       String
  updated_at DateTime?
  created_at DateTime  @default(now())

  client        Client          @relation(fields: [client_id], references: [id])
  files         ProjectFile[]
  folders       ProjectFolder[]
  project_steps ProjectStep[]
}

model ProjectFile {
  id              String    @id @default(uuid())
  project_id      String
  category_id     String?
  // Optional step of the project this file belongs to
  project_step_id String?
  // Folder the file is in; null = root of the project
  folder_id       String?
  created_by_id   String
  path            String?   @db.VarChar(4096)
  name            String?
  // Size in bytes. Double holds integers exactly up to 2^53 and, unlike
  // BigInt, serializes to JSON.
  size            Float?    @db.Double
  content_type    String?
  created_at      DateTime  @default(now())
  updated_at      DateTime?

  project      Project        @relation(fields: [project_id], references: [id])
  folder       ProjectFolder? @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  created_by   Employee       @relation(fields: [created_by_id], references: [id])
  category     Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  project_step ProjectStep?   @relation(fields: [project_step_id], references: [id], onDelete: SetNull)
}

// Folder tree of a project, of any depth. Category and step are only default
// tags given to files uploaded into the folder, not part of the hierarchy.
model ProjectFolder {
  id              String    @id @default(uuid())
  project_id      String
  // null = folder at the root of the project
  parent_id       String?
  name            String
  // Order among its siblings, starting at 0
  position        Int       @default(0)
  category_id     String?
  project_step_id String?
  created_by_id   String
  created_at      DateTime  @default(now())
  updated_at      DateTime?

  project      Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  parent       ProjectFolder?  @relation("FolderTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children     ProjectFolder[] @relation("FolderTree")
  files        ProjectFile[]
  created_by   Employee        @relation(fields: [created_by_id], references: [id])
  category     Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull)
  project_step ProjectStep?    @relation(fields: [project_step_id], references: [id], onDelete: SetNull)
}

model Step {
  id         String   @id @default(uuid())
  office_id  String
  name       String
  created_at DateTime @default(now())

  office      Office        @relation(fields: [office_id], references: [id])
  ProjectStep ProjectStep[]
}

model ProjectStep {
  id              String    @id @default(uuid())
  project_id      String
  step_id         String
  assigned_to     String?
  start_date      DateTime?
  end_date        DateTime?
  status          String
  step_hours      Int?
  last_updated_at DateTime?
  last_updated_by String?
  // Order of the step inside the project, starting at 0
  position        Int       @default(0)

  project  Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  step     Step            @relation(fields: [step_id], references: [id], onDelete: Cascade)
  assigned Employee?       @relation(fields: [assigned_to], references: [id], onDelete: SetNull)
  files    ProjectFile[]
  folders  ProjectFolder[]

  @@unique([project_id, step_id])
}
