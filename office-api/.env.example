# Copy to .env in this folder. Prisma loads it, which is how the whole app gets these values.

# MySQL from docker-compose.yaml. Root, so `prisma migrate dev` can create its shadow database.
MYSQL_URI=mysql://root:example@localhost:3306/my_database

# Redis from docker-compose.yaml
REDIS_HOST=localhost
REDIS_PORT=6379

# Signs employee and client JWTs. Any long random string.
SECRET=change-me

# office-project-posts HTTP server (project feed)
PROJECT_POSTS_SERVICE_URL=http://localhost:3001

# --- Only needed for uploads: office/client logos, employee avatars, project files ---
# AWS credentials (or leave these out and use ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
AWS_BUCKET=
# Full CloudFront URL, e.g. https://d1234abcd.cloudfront.net
AWS_CLOUDFRONT_DNS=
AWS_CLOUDFRONT_KEYPAIR_ID=
AWS_CLOUDFRONT_KEY_GROUP_ID=
# Path to the CloudFront private key .pem file
AWS_CLOUDFRONT_KEY_PATH=
